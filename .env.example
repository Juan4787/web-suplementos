# En desarrollo, la ausencia de credenciales activa una demo local identificada.
# En produccion, VITE_APP_MODE debe ser "supabase".
VITE_APP_MODE=supabase
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# La IA queda apagada hasta elegir y auditar proveedor/modelo.
VITE_AI_ENABLED=false
