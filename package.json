{
  "name": "suplementos-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-build-env.mjs && tsc -b && vite build",
    "check": "tsc -b",
    "preview": "vite preview",
    "worker:types": "wrangler types",
    "worker:dev": "REQUIRE_SUPABASE_ENV=1 pnpm build && wrangler --profile impulso dev --name impulso",
    "worker:secrets:sync": "node scripts/sync-worker-secrets.mjs",
    "worker:certify:dev": "node scripts/validate-worker-target.mjs && wrangler --profile impulso dev --remote --config wrangler.certification.jsonc",
    "worker:certify:run": "node scripts/run-ai-certification.mjs",
    "worker:deploy": "node scripts/validate-worker-target.mjs && REQUIRE_SUPABASE_ENV=1 pnpm build && wrangler --profile impulso deploy --name impulso",
    "worker:deploy:dry": "node scripts/validate-worker-target.mjs && REQUIRE_SUPABASE_ENV=1 pnpm build && wrangler --profile impulso deploy --name impulso --dry-run",
    "worker:smoke:ai": "node scripts/run-ai-production-smoke.mjs",
    "db:remote:list": "node scripts/run-supabase-linked.mjs list",
    "db:remote:push:dry": "node scripts/run-supabase-linked.mjs dry-run",
    "db:remote:push": "node scripts/run-supabase-linked.mjs push",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && playwright test",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "write-excel-file": "4.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/exceljs": "^1.3.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "exceljs": "^4.4.0",
    "fflate": "0.8.2",
    "jsdom": "26.1.0",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=11.1.1"
    }
  }
}
